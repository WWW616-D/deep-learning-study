# Copy to .env and fill in. .env is git-ignored; this template is not.
#
# Any OpenAI-compatible endpoint works. Examples:
#   DeepSeek      https://api.deepseek.com/v1
#   SiliconFlow   https://api.siliconflow.cn/v1
#   Zhipu GLM     https://open.bigmodel.cn/api/paas/v4
#   DashScope     https://dashscope.aliyuncs.com/compatible-mode/v1
#   ModelScope    https://api-inference.modelscope.cn/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# Optional: price per 1M tokens, used only to print an estimated cost.
# Leave blank to report raw token counts only.
LLM_PRICE_IN=
LLM_PRICE_OUT=
